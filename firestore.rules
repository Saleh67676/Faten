rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // ── Users ──
    // The blanket `{document=**}` recursive wildcard below grants the owner
    // access to EVERY sub-collection under their user document so we don't
    // need to enumerate (academic_records, completed_sessions, achievements,
    // semesters, transcripts, study_plans, exams, notifications, chat_history,
    // chat_history/*/messages, etc.) — adding a new sub-collection in code
    // will Just Work without a rules redeploy.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Default deny for everything else.
    match /{document=**} { allow read, write: if false; }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // ── Users ──
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /transcripts/{id}  { allow read, write: if isOwner(userId); }
      match /study_plans/{id}  { allow read, write: if isOwner(userId); }
      match /exams/{id}        { allow read, write: if isOwner(userId); }
      match /notifications/{id}{ allow read, write: if isOwner(userId); }
      match /chat_history/{id} {
        allow read, write: if isOwner(userId);
        match /messages/{msgId}{ allow read, write: if isOwner(userId); }
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
